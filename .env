# Live servers the app talks to (public addresses, not secrets).
# Remove EXPO_PUBLIC_SERVER_URL to use the API on your computer instead (port 4000 on the
# machine running `expo start`). Restart Expo after changing this file.
EXPO_PUBLIC_SERVER_URL=https://gopi-portfolio-api.onrender.com
EXPO_PUBLIC_WEBSITE_URL=https://gopi-portfolio-eight.vercel.app
