{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://gopi-portfolio-api.onrender.com",
        "EXPO_PUBLIC_WEBSITE_URL": "https://gopi-portfolio-eight.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://gopi-portfolio-api.onrender.com",
        "EXPO_PUBLIC_WEBSITE_URL": "https://gopi-portfolio-eight.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
